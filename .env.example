# PostgreSQL / Supabase
DATABASE_URL=postgres://user:password@localhost:5432/docuflow

# Object storage (AWS S3 atau Cloudflare R2, keduanya kompatibel S3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=docuflow-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Aplikasi
APP_URL=http://localhost:3000
MAX_UPLOAD_MB=20
SHARE_TTL_HOURS=24
